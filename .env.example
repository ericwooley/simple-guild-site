# Local development only. Set a password before starting PostgreSQL.
POSTGRES_PASSWORD=
# The server uses this connection string. Keep it private.
DATABASE_URL=postgresql://guild:YOUR_PASSWORD@127.0.0.1:5438/guild
APP_ORIGIN=http://localhost:4321
# Generate a random sync secret with at least 32 bytes.
SYNC_JWT_SECRET=
# Enable only for local human testing. Production always rejects test login.
ENABLE_LOCAL_TEST_LOGIN=false
# Optional Battle.net application setup. Never put secrets in browser code.
BNET_CLIENT_ID=
BNET_CLIENT_SECRET=
BNET_REDIRECT_URI=http://localhost:4321/auth/callback
BNET_REGION=us
# SMTP email delivery (Mailpit locally; Resend SMTP in production: smtp.resend.com:465 / user=resend / pass=API_KEY)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@bandofthehelpinghand.local
