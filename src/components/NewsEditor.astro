---
import ActionForm from './ActionForm.astro';
const {
  action = 'publish-news',
  label = 'Publish news',
  id = '',
  initialTitle = '',
  initialHtml = '',
} = Astro.props;
---
<ActionForm action={action} label={label} values={id ? { id } : undefined} class="stacked-form news-editor-form">
  <label>
    <span class="field-label-row"><span>Title</span><span class="char-counter" data-title-counter>0 / 120</span></span>
    <input name="title" maxlength="120" required value={initialTitle} placeholder="Raid night or guild update" />
  </label>
  <div class="wysiwyg-editor" data-wysiwyg data-max-chars="4000">
    <span class="field-label-row"><span class="wysiwyg-label">Message</span><span class="char-counter" data-wysiwyg-counter>0 / 4,000</span></span>
    <div class="wysiwyg-toolbar" role="toolbar" aria-label="Formatting options">
      <button type="button" class="wysiwyg-btn" data-cmd="bold" title="Bold"><strong>B</strong></button>
      <button type="button" class="wysiwyg-btn" data-cmd="italic" title="Italic"><em>I</em></button>
      <button type="button" class="wysiwyg-btn" data-cmd="underline" title="Underline"><u>U</u></button>
      <button type="button" class="wysiwyg-btn" data-cmd="formatBlock" data-value="h3" title="Heading">H3</button>
      <button type="button" class="wysiwyg-btn" data-cmd="insertUnorderedList" title="Bulleted list">• List</button>
      <button type="button" class="wysiwyg-btn" data-cmd="insertOrderedList" title="Numbered list">1. List</button>
      <button type="button" class="wysiwyg-btn" data-cmd="formatBlock" data-value="blockquote" title="Quote">Quote</button>
      <button type="button" class="wysiwyg-btn" data-cmd="createLink" title="Insert link">Link</button>
      <button type="button" class="wysiwyg-btn" data-cmd="removeFormat" title="Clear formatting">Clear</button>
    </div>
    <div class="wysiwyg-link-bar" data-wysiwyg-link-bar hidden>
      <input type="url" data-link-url placeholder="https://example.com" aria-label="Link URL" />
      <input type="text" data-link-text placeholder="Link text (optional)" aria-label="Link text" />
      <button type="button" class="btn-subtle" data-link-insert>Insert</button>
      <button type="button" class="btn-subtle" data-link-cancel>Cancel</button>
    </div>
    <div class="wysiwyg-surface" contenteditable="true" role="textbox" aria-multiline="true" aria-label="News message" data-placeholder="Write your announcement…" set:html={initialHtml}></div>
    <textarea name="body" class="wysiwyg-hidden" required aria-hidden="true" tabindex="-1">{initialHtml}</textarea>
  </div>
</ActionForm>
