---
import ActionForm from './ActionForm.astro';
const { requests = [], bank = [], owner = false } = Astro.props;
const transitions = {pending:['approved','declined'], approved:['fulfilled','declined']};
const bankByItemKey = new Map((bank ?? []).map(i => [i.itemKey, i]));
---
{requests.length ? <div class="record-list">{requests.map(request => {
  const item = bankByItemKey.get(request.itemKey);
  const supplyingBanks = (item?.banks ?? []).filter(b => !b.viewOnly && b.count >= request.quantity);
  return <article class="record-row">
    <div><h3>{request.itemName}</h3><p>{request.quantity} for {request.characterName}</p>{request.note && <p class="activity-message">{request.note}</p>}<p>{request.requesterName} · <span class="badge">{request.status}</span></p></div>
    {owner && <div class="row-actions">{(transitions[request.status] || []).map(status => status === 'fulfilled' && supplyingBanks.length > 1
      ? <ActionForm action="update-request" label="Mark fulfilled" values={{id:request.id,status}}><select name="bankName" aria-label="Supplying bank">{supplyingBanks.map(b => <option value={b.name}>{b.name} ({b.count})</option>)}</select></ActionForm>
      : <ActionForm action="update-request" label={{approved:'Approve',declined:'Decline',fulfilled:'Mark fulfilled'}[status]} values={{id:request.id,status}} />)}</div>}
  </article>;
})}</div> : <div class="empty-state compact-empty"><p>No item requests yet.</p><a class="text-link" href="/bank">Browse the bank</a></div>}
