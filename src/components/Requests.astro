---
import ActionForm from './ActionForm.astro';
import LocalTime from './LocalTime.astro';
const { requests = [], bank = [], owner = false } = Astro.props;
const transitions = {pending:['approved','declined'], approved:['fulfilled','declined']};
const bankByItemKey = new Map((bank ?? []).map(i => [i.itemKey, i]));
const gridClass = owner ? 'roster-table-requests-owner' : 'roster-table-requests';
---
{requests.length ? (
  <div class="roster-list" data-sortable-table>
    <div class={`roster-table-header ${gridClass}`}>
      <button type="button" class="sort-header" data-sort-col="0" data-sort-type="text">Item</button>
      <button type="button" class="sort-header" data-sort-col="1" data-sort-type="num">Qty</button>
      <button type="button" class="sort-header" data-sort-col="2" data-sort-type="text">Requested by</button>
      <button type="button" class="sort-header" data-sort-col="3" data-sort-type="text">Status</button>
      <button type="button" class="sort-header" data-sort-col="4" data-sort-type="num">Date</button>
      {owner && <span>Actions</span>}
    </div>
    {requests.map(request => {
      const item = bankByItemKey.get(request.itemKey);
      const supplyingBanks = (item?.banks ?? []).filter(b => !b.viewOnly && b.count >= request.quantity);
      const createdMs = request.createdAt ? (Date.parse(request.createdAt) || 0) : 0;
      return (
        <div
          class="roster-row"
          data-s0={request.itemName || ''}
          data-s1={String(request.quantity ?? 0)}
          data-s2={request.characterName || request.requesterName || ''}
          data-s3={request.status || ''}
          data-s4={String(createdMs)}
        >
          <div class={`roster-summary roster-summary-table roster-summary-static ${gridClass}`}>
            <div class="roster-identity">
              <strong class="roster-name">{request.itemName}</strong>
              {request.note && <span class="roster-meta">{request.note}</span>}
            </div>
            <span class="roster-cell">{request.quantity}</span>
            <div class="roster-identity">
              <span>{request.characterName}</span>
              {request.requesterName && <span class="roster-meta">{request.requesterName}</span>}
            </div>
            <span class="roster-cell"><span class="badge">{request.status}</span></span>
            <span class="roster-cell roster-cell-muted">{request.createdAt ? <LocalTime value={request.createdAt} /> : '—'}</span>
            {owner && (
              <div class="row-actions">
                {(transitions[request.status] || []).map(status => status === 'fulfilled' && supplyingBanks.length > 1
                  ? <ActionForm action="update-request" label="Mark fulfilled" values={{id:request.id,status}}><select name="bankName" aria-label="Supplying bank">{supplyingBanks.map(b => <option value={b.name}>{b.name} ({b.count})</option>)}</select></ActionForm>
                  : <ActionForm action="update-request" label={{approved:'Approve',declined:'Decline',fulfilled:'Mark fulfilled'}[status]} values={{id:request.id,status}} />)}
              </div>
            )}
          </div>
        </div>
      );
    })}
  </div>
) : <div class="empty-state compact-empty"><p>No item requests yet.</p><a class="text-link" href="/bank">Browse the bank</a></div>}
