---
const {
  page = 1,
  totalPages = 1,
  totalItems = 0,
  pageSize = 50,
  pageUrl,
  label = 'Pagination'
} = Astro.props;

const start = totalItems === 0 ? 0 : (page - 1) * pageSize + 1;
const end = Math.min(totalItems, page * pageSize);

const pages: Array<number | 'ellipsis'> = [];
if (totalPages <= 7) {
  for (let i = 1; i <= totalPages; i++) pages.push(i);
} else {
  pages.push(1);
  if (page > 3) pages.push('ellipsis');
  for (let i = Math.max(2, page - 1); i <= Math.min(totalPages - 1, page + 1); i++) pages.push(i);
  if (page < totalPages - 2) pages.push('ellipsis');
  pages.push(totalPages);
}
---
{totalPages > 1 && (
  <nav class="pagination-bar" aria-label={label}>
    <span class="pagination-summary">Showing {start}–{end} of {totalItems}</span>
    <div class="pagination-controls">
      {page > 1
        ? <a class="pill" href={pageUrl(page - 1)} rel="prev">Previous</a>
        : <span class="pill pill-disabled" aria-disabled="true">Previous</span>}
      {pages.map(item =>
        item === 'ellipsis'
          ? <span class="pagination-ellipsis" aria-hidden="true">…</span>
          : item === page
            ? <span class="pill pill-active" aria-current="page">{item}</span>
            : <a class="pill" href={pageUrl(item)}>{item}</a>
      )}
      {page < totalPages
        ? <a class="pill" href={pageUrl(page + 1)} rel="next">Next</a>
        : <span class="pill pill-disabled" aria-disabled="true">Next</span>}
    </div>
  </nav>
)}
