---
interface Props { large?: boolean; logoUrl?: string | null; logoName?: string | null; }
const { large = false, logoUrl = null, logoName = null } = Astro.props;
const size = large ? 210 : 54;
---
{logoUrl ? (
  <img
    src={logoUrl}
    alt=""
    title={logoName || undefined}
    width={size}
    height={size}
    class:list={['guild-crest', { 'guild-crest-large': large }]}
    decoding="async"
    aria-hidden="true"
  />
) : (
  <picture class="guild-crest-picture" aria-hidden="true">
    <source srcset="/guild-crest.webp" type="image/webp" />
    <img
      src="/guild-crest.png"
      alt=""
      title={logoName || undefined}
      width={size}
      height={size}
      class:list={['guild-crest', { 'guild-crest-large': large }]}
      decoding="async"
    />
  </picture>
)}
