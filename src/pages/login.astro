---
import Layout from '../layouts/Layout.astro';
import ActionForm from '../components/ActionForm.astro';
import { getPortalData } from '../server/service.mjs';
const {account, guild, characters, isGuildMaster, localTestLogin, battleNetConfigured} = await getPortalData(Astro.request);
---
<Layout title="Sign in" account={account} guild={guild} characters={characters} isGuildMaster={isGuildMaster}><div class="page-heading"><h1>Sign in</h1></div><div class="login-layout"><section class="guild-panel arcane-card-highlight" aria-labelledby="battlenet-heading"><h2 id="battlenet-heading">Battle.net</h2>{account ? <div class="empty-state"><p>You signed in as {account.battleTag}.</p><a class="arcane-btn" href="/account">Open my account</a></div> : battleNetConfigured ? <div class="empty-state"><form method="get" action="/auth/battlenet" class="stacked-form"><label class="check-label"><input type="checkbox" name="terms" value="1" required /><span>I agree to the <a class="text-link" href="/terms" target="_blank" rel="noopener">Terms &amp; Conditions</a> and <a class="text-link" href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</span></label><button type="submit" class="arcane-btn">Continue with Battle.net</button></form></div> : <div class="empty-state"><p>The site owner must configure Battle.net sign-in before members can connect their accounts.</p></div>}</section>
{localTestLogin && !account && <section class="guild-panel arcane-card-highlight" aria-labelledby="test-heading"><h2 id="test-heading">Local test accounts</h2><div class="test-account-actions"><ActionForm action="local-login" label="Test as guild member" values={{persona:'member'}} /><ActionForm action="local-login" label="Test as guild owner" values={{persona:'owner'}} /></div><p class="notice">These accounts contain test records for local human testing.</p></section>}</div></Layout>
