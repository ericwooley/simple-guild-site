---
import Layout from '../layouts/Layout.astro';
import GuildCrest from '../components/GuildCrest.astro';
import GuildPanel from '../components/GuildPanel.astro';
import NewsEditor from '../components/NewsEditor.astro';
import CommendationForm from '../components/CommendationForm.astro';
import LocalTime from '../components/LocalTime.astro';
import ActivityItem from '../components/ActivityItem.astro';
import Pagination from '../components/Pagination.astro';
import { getPortalData } from '../server/service.mjs';
import { getPool } from '../server/db.mjs';
import { stripHtmlText } from '../server/sanitizeHtml.mjs';
import { buildReviewMacro, buildShortFeedbackUrl, loadCachedFeedbackShortUrls } from '../server/feedbackLinks.mjs';
const data = await getPortalData(Astro.request);
const { account, guild, characters, roster, activityFeed, isGuildMaster, permissions, motd, guildInfo, news, macros } = data;
const guildName = guild?.name || 'Band of the Helping Hand';
const siteOrigin = (process.env.APP_ORIGIN || Astro.url.origin).replace(/\/+$/, '');
const primaryCharForReview = (account?.guildCharacters ?? []).find(gc => gc.id === account?.primaryCharacterId)
  ?? characters.find(c => c.isMain && c.verified && c.guildRank)
  ?? (account?.guildCharacters ?? [])[0]
  ?? null;
const cachedShortLinks = guild && primaryCharForReview
  ? await loadCachedFeedbackShortUrls(getPool(), siteOrigin, [primaryCharForReview.id])
  : new Map();
const primaryCachedShortUrl = primaryCharForReview ? (cachedShortLinks.get(primaryCharForReview.id) ?? '') : '';
const primaryReviewLink = guild && primaryCharForReview ? (primaryCachedShortUrl || buildShortFeedbackUrl(siteOrigin, primaryCharForReview.id)) : '';
const personalReviewMacro = primaryReviewLink
  ? {
      title: 'Ask for a helping-hand review',
      body: buildReviewMacro(guildName, primaryReviewLink),
      template: buildReviewMacro(guildName, '{{URL}}'),
      characterId: !primaryCachedShortUrl && primaryCharForReview ? primaryCharForReview.id : undefined,
    }
  : null;
const totalMacroCount = macros.length + (personalReviewMacro ? 1 : 0);
const ownIds = new Set(characters.map(c => c.id));
const ownNames = new Set(characters.map(c => c.name.trim().toLowerCase()));
const eligibleMembers = roster
  .filter(m => !ownIds.has(m.id) && !ownNames.has(m.name.trim().toLowerCase()))
  .sort((a, b) => a.name.localeCompare(b.name))
  .map(m => ({ id: m.id, name: m.name, rank: m.guildRank || '', level: m.level ?? null }));

const newsPageSize = 5;
const newsTotalPages = Math.max(1, Math.ceil(news.length / newsPageSize));
const rawNPage = Number(Astro.url.searchParams.get('npage') || '1');
const newsPage = Number.isSafeInteger(rawNPage) && rawNPage >= 1 ? Math.min(rawNPage, newsTotalPages) : 1;
const pageNews = news.slice((newsPage - 1) * newsPageSize, newsPage * newsPageSize);

const SYSTEM_MAILERS = new Set([
  'alliance auction house',
  'horde auction house',
  'blackwater auction house',
  'auction house',
  'the postmaster',
]);
const homeActivity = activityFeed.filter(entry => {
  if (entry.kind === 'commendation') return true;
  if (entry.kind === 'donation') {
    const actor = String(entry.actorName || '').trim().toLowerCase();
    return Boolean(actor) && !SYSTEM_MAILERS.has(actor);
  }
  return false;
});

const actPageSize = 5;
const actTotalPages = Math.max(1, Math.ceil(homeActivity.length / actPageSize));
const rawAPage = Number(Astro.url.searchParams.get('apage') || '1');
const actPage = Number.isSafeInteger(rawAPage) && rawAPage >= 1 ? Math.min(rawAPage, actTotalPages) : 1;
const pageActivity = homeActivity.slice((actPage - 1) * actPageSize, actPage * actPageSize);

const homeUrl = (overrides: Record<string, number>, hash = '') => {
  const params = new URLSearchParams();
  const next = { npage: newsPage, apage: actPage, ...overrides };
  if (next.npage > 1) params.set('npage', String(next.npage));
  if (next.apage > 1) params.set('apage', String(next.apage));
  const qs = params.toString();
  return `${qs ? `/?${qs}` : '/'}${hash}`;
};
---
<Layout account={account} guild={guild} characters={characters} isGuildMaster={isGuildMaster}>
<section class="hero" aria-labelledby="guild-title"><img class="hero-landscape" src="/guild-landscape.svg" alt="" width="1440" height="600" fetchpriority="high" /><div class="hero-shade" aria-hidden="true"></div>
<div class="hero-content"><h1 id="guild-title" class="arcane-title">{guildName}</h1>{!account ? <div class="hero-actions"><a href="/login" class="arcane-btn">Sign in</a></div> : primaryReviewLink && <div class="hero-actions"><button type="button" class="arcane-btn" data-copy-text={primaryReviewLink} data-short-review-character={!primaryCachedShortUrl && primaryCharForReview ? primaryCharForReview.id : undefined}>Copy my review link</button></div>}</div>
<div class="hero-standard" aria-hidden="true"><div class="standard-ring"></div><GuildCrest large logoUrl={guild?.logoUrl} logoName={guild?.logoName} /></div>
<span class="hero-corner top-left" aria-hidden="true"></span><span class="hero-corner top-right" aria-hidden="true"></span><span class="hero-corner bottom-left" aria-hidden="true"></span><span class="hero-corner bottom-right" aria-hidden="true"></span></section>
{account ? <>
{(motd || guildInfo) && <GuildPanel id="motd" title="Message of the day" icon="notice">{motd && <p class="motd-text">{motd.text}</p>}{guildInfo && <p class="notice">{guildInfo.text}</p>}{motd?.updatedAt && <p class="data-age">Updated <LocalTime value={motd.updatedAt} /> by {motd.updatedBy}</p>}</GuildPanel>}
<div class="guild-grid">
  <GuildPanel id="activity" title="Guild activity" icon="users">
    <CommendationForm members={eligibleMembers} compact label="Thank" />
    <div class="activity-feed">
      {pageActivity.map(entry => <ActivityItem entry={entry} />)}
      {!homeActivity.length && <p class="notice">No thanks or donations yet. Thank a guildmate above or sync bank donations.</p>}
    </div>
    <Pagination page={actPage} totalPages={actTotalPages} totalItems={homeActivity.length} pageSize={actPageSize} pageUrl={(p: number) => homeUrl({ apage: p }, '#activity')} label="Guild activity pagination" />
    <a class="text-link" href="/activity">Open full activity feed</a>
  </GuildPanel>
  <div class="guild-col">
    {totalMacroCount > 0 && (
      <details class="column-picker macro-drawer" id="guild-macros">
        <summary class="column-picker-summary">
          <span class="column-picker-label">Guild macros</span>
          <span class="badge">{totalMacroCount}</span>
        </summary>
        <div class="macro-list">
          {personalReviewMacro && (
            <article class="macro-item" data-personal-review-macro>
              <div class="macro-item-header">
                <strong>{personalReviewMacro.title}</strong>
                <button
                  type="button"
                  class="btn-subtle"
                  data-copy-text={personalReviewMacro.body}
                  data-copy-template={personalReviewMacro.template}
                  data-short-review-character={personalReviewMacro.characterId}
                >Copy</button>
              </div>
              <pre class="macro-code">{personalReviewMacro.body}</pre>
            </article>
          )}
          {macros.map(macro => (
            <article class="macro-item">
              <div class="macro-item-header">
                <strong>{macro.title}</strong>
                <button type="button" class="btn-subtle" data-copy-text={macro.body}>Copy</button>
              </div>
              <pre class="macro-code">{macro.body}</pre>
            </article>
          ))}
        </div>
      </details>
    )}
    <GuildPanel id="news" title="Guild news" icon="notice">
    {permissions.manageAnnouncements && (
      <details class="news-composer">
        <summary class="btn-subtle">Add guild news</summary>
        <div class="news-composer-body">
          <NewsEditor />
        </div>
      </details>
    )}
    {pageNews.length > 0 && (
      <div class="news-feed">
        {pageNews.map(item => {
          const excerpt = stripHtmlText(item.html);
          const postUrl = `/news/${encodeURIComponent(item.id)}`;
          return (
            <article class="news-feed-item">
              <a class="news-link" href={postUrl}><strong>{item.title}</strong></a>
              {excerpt && (
                <a class="news-excerpt-link" href={postUrl}>
                  <p class="news-excerpt">{excerpt}</p>
                </a>
              )}
              <div class="news-entry-footer">
                <span class="roster-meta">{item.authorName} · <LocalTime value={item.publishedAt} fallback="Never" /></span>
              </div>
            </article>
          );
        })}
      </div>
    )}
    {!news.length && <p class="notice">No guild news published yet.</p>}
    <Pagination page={newsPage} totalPages={newsTotalPages} totalItems={news.length} pageSize={newsPageSize} pageUrl={(p: number) => homeUrl({ npage: p }, '#news')} label="Guild news pagination" />
  </GuildPanel>
  </div>
</div>
</> : <div class="feature-grid"><a href="/roster" class="feature-card"><h2>Guild roster</h2></a><a href="/bank" class="feature-card"><h2>Guild bank</h2></a><a href="/professions" class="feature-card"><h2>Professions</h2></a></div>}
</Layout>
