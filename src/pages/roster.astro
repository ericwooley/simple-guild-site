---
import Layout from '../layouts/Layout.astro';
import SignInGate from '../components/SignInGate.astro';
import LocalTime from '../components/LocalTime.astro';
import Pagination from '../components/Pagination.astro';
import { getPortalData } from '../server/service.mjs';
import { professionColumnList, professionCap } from '../server/professionSlots.mjs';
import { levelQualityClass, professionQualityClass, rankQualityClass } from '../server/rarity.mjs';
const {account, guild, roster, characters, isGuildMaster, permissions} = await getPortalData(Astro.request);
const canViewLedger = isGuildMaster || permissions.approveBankRequests || permissions.manageGuildSync;
const q = Astro.url.searchParams.get('q')?.trim() || '';
const query = q.toLowerCase();
const selectedProfession = Astro.url.searchParams.get('profession')?.trim() || '';
const minSkillParam = Astro.url.searchParams.get('minSkill')?.trim() || '';
const minSkill = minSkillParam && /^\d+$/.test(minSkillParam) ? Number(minSkillParam) : 0;
const selectedRank = Astro.url.searchParams.get('rank')?.trim() || '';
const minLevelParam = Astro.url.searchParams.get('minLevel')?.trim() || '';
const minLevel = minLevelParam && /^\d+$/.test(minLevelParam) ? Number(minLevelParam) : 0;
const maxLevelParam = Astro.url.searchParams.get('maxLevel')?.trim() || '';
const maxLevel = maxLevelParam && /^\d+$/.test(maxLevelParam) ? Number(maxLevelParam) : 0;
const sortBy = Astro.url.searchParams.get('sort')?.trim() || '';

const professionNames = [...new Set(roster.flatMap(m => (m.professions ?? []).map(p => p.name)))].sort((a, b) => a.localeCompare(b));
const profColumns = professionColumnList(professionNames);
const isProfVisibleDefault = (name: string) => Boolean(selectedProfession) && selectedProfession === name;
const defaultVisibleProfCount = profColumns.filter(isProfVisibleDefault).length;
const rankNames = [...new Set(roster.map(m => m.guildRank).filter(Boolean))].sort((a, b) => String(a).localeCompare(String(b)));

const skillFor = (member: { professions?: Array<{ name: string; rank: number | null }> }, profName: string) =>
  (member.professions ?? []).find(p => p.name === profName)?.rank ?? 0;

const profEntryFor = (member: { professions?: Array<{ name: string; rank: number | null }> }, profName: string) =>
  (member.professions ?? []).find(p => p.name === profName) ?? null;

const members = roster
  .filter(member => {
    const profs = member.professions ?? [];
    const haystack = `${member.name} ${member.className || ''} ${member.guildRank || ''} ${member.titles.join(' ')} ${profs.map(p => p.name).join(' ')}`.toLowerCase();
    const matchesProfession = !selectedProfession || profs.some(p => p.name === selectedProfession && (!minSkill || (p.rank ?? 0) >= minSkill));
    const matchesSkillOnly = selectedProfession || !minSkill || profs.some(p => (p.rank ?? 0) >= minSkill);
    return haystack.includes(query)
      && matchesProfession
      && matchesSkillOnly
      && (!selectedRank || member.guildRank === selectedRank)
      && (!minLevel || (member.level ?? 0) >= minLevel)
      && (!maxLevel || (member.level !== null && member.level !== undefined && member.level <= maxLevel));
  })
  .sort((a, b) => {
    if (sortBy === 'reputation') {
      const diff = (b.reputationCount ?? 0) - (a.reputationCount ?? 0);
      if (diff !== 0) return diff;
    }
    if (sortBy === 'level') {
      const diff = (b.level ?? 0) - (a.level ?? 0);
      if (diff !== 0) return diff;
    }
    if (selectedProfession) {
      const diff = skillFor(b, selectedProfession) - skillFor(a, selectedProfession);
      if (diff !== 0) return diff;
    }
    return (a.guildRankIndex ?? 99) - (b.guildRankIndex ?? 99)
      || (b.level ?? 0) - (a.level ?? 0)
      || a.name.localeCompare(b.name);
  });

const pageSize = 50;
const totalPages = Math.max(1, Math.ceil(members.length / pageSize));
const rawPage = Number(Astro.url.searchParams.get('page') || '1');
const page = Number.isSafeInteger(rawPage) && rawPage >= 1 ? Math.min(rawPage, totalPages) : 1;
const pageMembers = members.slice((page - 1) * pageSize, page * pageSize);

const pageUrl = (p: number) => {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (selectedProfession) params.set('profession', selectedProfession);
  if (minSkill) params.set('minSkill', String(minSkill));
  if (selectedRank) params.set('rank', selectedRank);
  if (minLevel) params.set('minLevel', String(minLevel));
  if (maxLevel) params.set('maxLevel', String(maxLevel));
  if (p > 1) params.set('page', String(p));
  const qs = params.toString();
  return qs ? `/roster?${qs}` : '/roster';
};
---
<Layout title="Guild roster" account={account} guild={guild} characters={characters} isGuildMaster={isGuildMaster}>
  <div class="page-heading"><h1>Guild roster</h1>{account && <span class="badge">{members.length} of {roster.length} characters</span>}</div>
  {!account ? <SignInGate /> : <>
    <form class="filter-bar" method="get">
      <label>Find a character<input name="q" type="search" value={q} placeholder="Name, class, title…" /></label>
      <label>Profession
        <select name="profession">
          <option value="">All professions</option>
          {professionNames.map(name => <option value={name} selected={selectedProfession === name}>{name}</option>)}
        </select>
      </label>
      <label>Profession skill
        <select name="minSkill">
          <option value="">Any skill</option>
          <option value="75" selected={minSkill === 75}>75+ (Journeyman)</option>
          <option value="150" selected={minSkill === 150}>150+ (Expert)</option>
          <option value="225" selected={minSkill === 225}>225+ (Artisan)</option>
          <option value="300" selected={minSkill === 300}>300 (Master)</option>
        </select>
      </label>
      <label>Rank
        <select name="rank">
          <option value="">All ranks</option>
          {rankNames.map(name => <option value={name} selected={selectedRank === name}>{name}</option>)}
        </select>
      </label>
      <label class="level-range-field">Level min<input name="minLevel" type="number" min="1" max="60" step="1" value={minLevel || ''} placeholder="1" /></label>
      <label class="level-range-field">Level max<input name="maxLevel" type="number" min="1" max="60" step="1" value={maxLevel || ''} placeholder="60" /></label>
      <a class="text-link" href="/roster">Clear</a>
    </form>

    <details class="column-picker" data-column-picker="roster-prof-cols" data-target="roster-table" data-force-col={selectedProfession || ''}>
      <summary class="column-picker-summary">
        <span class="column-picker-label">Profession columns</span>
        <span class="badge" data-col-count>{defaultVisibleProfCount} shown</span>
      </summary>
      <div class="column-picker-body">
        <div class="column-picker-list">
          {profColumns.map(name => (
            <label class="column-picker-item">
              <input type="checkbox" value={name} checked={isProfVisibleDefault(name)} />
              <span>{name}</span>
            </label>
          ))}
        </div>
        <div class="column-picker-actions">
          <button type="button" class="text-link" data-col-all>All</button>
          <button type="button" class="text-link" data-col-none>None</button>
        </div>
      </div>
    </details>

    <div class="roster-table-scroll">
    <div id="roster-table" class="roster-list" data-sortable-table data-has-prof-cols={defaultVisibleProfCount > 0 ? '1' : '0'} style={defaultVisibleProfCount > 0 ? `--prof-cols: ${defaultVisibleProfCount}` : undefined}>
      {members.length > 0 && (
        <div class="roster-table-header roster-table-roster">
          <button type="button" class="sort-header" data-sort-col="0" data-sort-type="num">Lvl</button>
          <button type="button" class="sort-header" data-sort-col="1" data-sort-type="text">Character</button>
          <button type="button" class="sort-header" data-sort-col="2" data-sort-type="num" data-sort-default="asc">Rank</button>
          <button type="button" class="sort-header" data-sort-col="3" data-sort-type="num">Rep</button>
          <button type="button" class="sort-header" data-sort-col="4" data-sort-type="num">Contribution</button>
          {profColumns.map((profName, idx) => (
            <button type="button" class="sort-header" data-sort-col={String(5 + idx)} data-sort-type="num" data-prof-col={profName} hidden={!isProfVisibleDefault(profName)}>{profName}</button>
          ))}
        </div>
      )}
      {pageMembers.map(member => {
        const profSortAttrs = Object.fromEntries(profColumns.map((profName, idx) => {
          const entry = profEntryFor(member, profName);
          return [`data-s${5 + idx}`, entry && entry.rank !== null ? String(entry.rank) : ''];
        }));
        return (
        <details
          class="roster-row"
          data-s-name={member.name}
          data-s0={member.level ?? ''}
          data-s1={member.name}
          data-s2={member.guildRankIndex ?? ''}
          data-s3={member.reputationCount ?? 0}
          data-s4={member.donatedCopper ?? 0}
          {...profSortAttrs}
        >
          <summary class="roster-summary roster-summary-table roster-table-roster">
            <span class={`roster-cell roster-cell-level ${member.level ? levelQualityClass(member.level) : 'roster-cell-muted'}`}>{member.level ?? '—'}</span>
            <div class="roster-identity">
              <strong class="roster-name">{member.name}</strong>
              {member.className && <span class="roster-meta">{member.className}</span>}
              {member.titles.map(title => <span class="badge">{title}</span>)}
            </div>
            <span class={`roster-cell ${member.guildRank ? rankQualityClass(member.guildRankIndex) : 'roster-cell-muted'}`}>{member.guildRank || 'Unknown'}</span>
            <span class={`roster-cell rep-tag ${member.reputationQualityClass || 'quality-poor'}`} title={`${member.helpingPoints ?? 0} helping pts · ${member.donationPoints ?? 0} donation pts`}>{member.reputation?.label ?? 'Neutral (0)'}</span>
            <span class={`roster-cell ${(member.donatedCopper ?? 0) > 0 ? (member.donatedQualityClass || 'donation-value') : 'roster-cell-muted'}`}>{member.donatedFormatted ?? '0c'}</span>
            {profColumns.map(profName => {
              const entry = profEntryFor(member, profName);
              const learned = Boolean(entry);
              const cap = learned ? professionCap(profName, entry!.maxRank, entry!.rank) : 300;
              const qClass = learned && entry!.rank !== null ? professionQualityClass(entry!.rank, cap) : 'roster-cell-muted';
              const label = learned ? (entry!.rank !== null ? String(entry!.rank) : 'Learned') : '—';
              return (
                <span class={`roster-cell ${qClass}${selectedProfession === profName && learned ? ' roster-cell-active' : ''}`} data-prof-col={profName} data-col={profName} hidden={!isProfVisibleDefault(profName)}>
                  {label}
                </span>
              );
            })}
          </summary>
          <div class="roster-details">
            <dl>
              <div><dt>Character</dt><dd><span class={member.level ? levelQualityClass(member.level) : ''}>{[member.level ? `Level ${member.level}` : null, member.className].filter(Boolean).join(' ') || 'Unknown'}</span></dd></div>
              <div><dt>Realm</dt><dd>{member.realm}</dd></div>
              <div><dt>Guild rank</dt><dd><span class={member.guildRank ? rankQualityClass(member.guildRankIndex) : ''}>{member.guildRank || 'Unknown'}</span></dd></div>
              <div><dt>Guild reputation</dt><dd><span class={`rep-tag ${member.reputationQualityClass || 'quality-poor'}`}>{member.reputation?.label ?? 'Neutral (0)'}</span>{member.reputationCount ? ` (${member.helpingPoints ?? 0} helping · ${member.donationPoints ?? 0} donation)` : ''}</dd></div>
              <div><dt>Bank contribution</dt><dd><span class={(member.donatedCopper ?? 0) > 0 ? (member.donatedQualityClass || 'donation-value') : ''}>{member.donatedFormatted ?? '0c'}</span>{member.donationCount ? ` (${member.donationCount} ${member.donationCount === 1 ? 'contribution' : 'contributions'})` : ''}</dd></div>
              {canViewLedger && (
                <>
                  <div><dt>Bank withdrawn</dt><dd><span class={(member.withdrawnCopper ?? 0) > 0 ? 'withdraw-value' : ''}>{member.withdrawnFormatted ?? '0c'}</span>{member.withdrawnCount ? ` (${member.withdrawnCount})` : ''}</dd></div>
                  <div><dt>Net contribution</dt><dd><span class={(member.netContributionCopper ?? 0) < 0 ? 'withdraw-value' : (member.netContributionCopper ?? 0) > 0 ? 'donation-value' : ''}>{member.netContributionFormatted ?? '0c'}</span></dd></div>
                </>
              )}
              <div><dt>Account link</dt><dd>{member.verified ? 'Verified' : 'Not verified'}</dd></div>
              <div><dt>Last sync</dt><dd><LocalTime value={member.updatedAt} fallback="Unknown" /></dd></div>
            </dl>
            {(member.professions ?? []).length > 0 && (
              <div class="roster-details-profs">
                {member.professions.map(prof => { const cap = professionCap(prof.name, prof.maxRank, prof.rank); const qClass = professionQualityClass(prof.rank, cap); return (
                  <div class="roster-prof-item">
                    <div class="card-heading">
                      <strong class={qClass}>{prof.name}</strong>
                      <span class={`skill-rank ${qClass}`}>{prof.rank !== null ? `${prof.rank} / ${cap}` : 'Learned'}{prof.recipeCount ? ` · ${prof.recipeCount} recipes` : ''}</span>
                    </div>
                    {prof.rank !== null ? <progress class={qClass} value={prof.rank} max={cap} aria-label={`${member.name} ${prof.name} skill`}></progress> : null}
                  </div>
                ); })}
              </div>
            )}
            <div class="roster-details-actions">
              <a class="arcane-btn arcane-btn-secondary" href={`/character/${encodeURIComponent(member.id)}`}>View full profile</a>
            </div>
          </div>
        </details>
        );
      })}
    </div>
    </div>
    <Pagination page={page} totalPages={totalPages} totalItems={members.length} pageSize={pageSize} pageUrl={pageUrl} label="Roster pagination" />
    {!members.length && <p class="notice">{roster.length ? 'No characters match your filters.' : 'The guild owner must sync the roster from the addon.'}</p>}
  </>}
</Layout>
