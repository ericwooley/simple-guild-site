---
import Layout from '../layouts/Layout.astro';
import GuildPanel from '../components/GuildPanel.astro';
import SignInGate from '../components/SignInGate.astro';
import ActionForm from '../components/ActionForm.astro';
import Requests from '../components/Requests.astro';
import LocalTime from '../components/LocalTime.astro';
import Pagination from '../components/Pagination.astro';
import { getPortalData } from '../server/service.mjs';
import { formatCopper } from '../server/itemPrices.mjs';
import { rankQualityClass } from '../server/rarity.mjs';

const {account, guild, roster, bank, bankTransactions, characters, requests, isGuildMaster, permissions} = await getPortalData(Astro.request);
const canViewLedger = isGuildMaster || permissions.approveBankRequests || permissions.manageGuildSync;
const rawTab = Astro.url.searchParams.get('tab');
const tab = rawTab === 'requests' ? 'requests' : rawTab === 'history' ? 'history' : (rawTab === 'ledger' && canViewLedger ? 'ledger' : 'stock');
const q = Astro.url.searchParams.get('q')?.trim() || '';
const favorites = Astro.url.searchParams.get('favorites') === '1';
const source = Astro.url.searchParams.get('source') || '';
const itemClass = Astro.url.searchParams.get('itemClass') || '';
const itemSubclass = Astro.url.searchParams.get('itemSubclass') || '';
const slotFilter = Astro.url.searchParams.get('slot') || '';
const qualityFilter = Astro.url.searchParams.get('quality') || '';
const minReqParam = Astro.url.searchParams.get('minReq')?.trim() || '';
const maxReqParam = Astro.url.searchParams.get('maxReq')?.trim() || '';
const minReq = minReqParam && /^\d+$/.test(minReqParam) ? Number(minReqParam) : 0;
const maxReq = maxReqParam && /^\d+$/.test(maxReqParam) ? Number(maxReqParam) : 0;
const historyFilter = Astro.url.searchParams.get('history') || 'attributed';
const historyPlayer = Astro.url.searchParams.get('player')?.trim() || '';
const historyPlayerLower = historyPlayer.toLowerCase();

const sourceNames = [...new Set(bank.flatMap(item => item.banks.map(bank => bank.name)))].sort((a, b) => a.localeCompare(b));
const classNames = [...new Set(bank.map(item => item.itemClass).filter(Boolean))].sort((a, b) => String(a).localeCompare(String(b)));
const subclassNames = [...new Set(
  bank
    .filter(item => !itemClass || item.itemClass === itemClass)
    .map(item => item.itemSubclass)
    .filter(Boolean)
)].sort((a, b) => String(a).localeCompare(String(b)));
const slotNames = [...new Set(bank.map(item => item.inventoryType).filter(Boolean))].sort((a, b) => String(a).localeCompare(String(b)));
const qualityOrder = ['Poor', 'Common', 'Uncommon', 'Rare', 'Epic', 'Legendary'];
const qualityNames = qualityOrder.filter(qn => bank.some(item => item.qualityName === qn));

const visibleTransactions = bankTransactions.filter(tx => tx.txType !== 'mailed');
const historyPlayers = [...new Set(visibleTransactions.map(tx => tx.actorName).filter(Boolean))].sort((a, b) => String(a).localeCompare(String(b)));

const items = bank.filter(item => {
  const haystack = `${item.name} ${item.itemId} ${item.itemClass || ''} ${item.itemSubclass || ''} ${item.inventoryType || ''}`.toLowerCase();
  if (q && !haystack.includes(q.toLowerCase())) return false;
  if (favorites && !item.favorite) return false;
  if (source && !item.banks.some(b => b.name === source)) return false;
  if (itemClass && item.itemClass !== itemClass) return false;
  if (itemSubclass && item.itemSubclass !== itemSubclass) return false;
  if (slotFilter && item.inventoryType !== slotFilter) return false;
  if (qualityFilter && item.qualityName !== qualityFilter) return false;
  if (minReq && (item.requiredLevel ?? 0) < minReq) return false;
  if (maxReq && (item.requiredLevel ?? 0) > maxReq) return false;
  return true;
});

const filteredHistory = visibleTransactions.filter(tx => {
  if (historyFilter === 'attributed' && !tx.actorName) return false;
  if (historyFilter === 'donations' && !tx.isDonation) return false;
  if (historyPlayerLower && !(tx.actorName || '').toLowerCase().includes(historyPlayerLower)) return false;
  return true;
});

const itemPageSize = 25;
const pageSize = 50;
const itemsTotalPages = Math.max(1, Math.ceil(items.length / itemPageSize));
const rawPage = Number(Astro.url.searchParams.get('page') || '1');
const itemPage = Number.isSafeInteger(rawPage) && rawPage >= 1 ? Math.min(rawPage, itemsTotalPages) : 1;
const pageItems = items.slice((itemPage - 1) * itemPageSize, itemPage * itemPageSize);

const historyTotalPages = Math.max(1, Math.ceil(filteredHistory.length / pageSize));
const rawHPage = Number(Astro.url.searchParams.get('hpage') || '1');
const historyPage = Number.isSafeInteger(rawHPage) && rawHPage >= 1 ? Math.min(rawHPage, historyTotalPages) : 1;
const pageHistory = filteredHistory.slice((historyPage - 1) * pageSize, historyPage * pageSize);

const ledgerRows = canViewLedger
  ? roster
      .filter(m => !historyPlayerLower || m.name.toLowerCase().includes(historyPlayerLower))
      .sort((a, b) => (b.netContributionCopper ?? 0) - (a.netContributionCopper ?? 0) || (b.donatedCopper ?? 0) - (a.donatedCopper ?? 0) || a.name.localeCompare(b.name))
  : [];
const ledgerTotals = canViewLedger
  ? ledgerRows.reduce((acc, m) => ({
      donated: acc.donated + (m.donatedCopper ?? 0),
      withdrawn: acc.withdrawn + (m.withdrawnCopper ?? 0),
      net: acc.net + (m.netContributionCopper ?? 0)
    }), { donated: 0, withdrawn: 0, net: 0 })
  : { donated: 0, withdrawn: 0, net: 0 };

const ledgerTotalPages = Math.max(1, Math.ceil(ledgerRows.length / pageSize));
const rawLPage = Number(Astro.url.searchParams.get('lpage') || '1');
const ledgerPage = Number.isSafeInteger(rawLPage) && rawLPage >= 1 ? Math.min(rawLPage, ledgerTotalPages) : 1;
const pageLedgerRows = ledgerRows.slice((ledgerPage - 1) * pageSize, ledgerPage * pageSize);

const requestPageSize = 20;
const requestTotalPages = Math.max(1, Math.ceil(requests.length / requestPageSize));
const rawRPage = Number(Astro.url.searchParams.get('rpage') || '1');
const requestPage = Number.isSafeInteger(rawRPage) && rawRPage >= 1 ? Math.min(rawRPage, requestTotalPages) : 1;
const pageRequests = requests.slice((requestPage - 1) * requestPageSize, requestPage * requestPageSize);

const openRequestCount = requests.filter(r => r.status === 'pending' || r.status === 'approved').length;

const bankUrl = (overrides: Record<string, string | number | null>, hash = '') => {
  const params = new URLSearchParams();
  const next: Record<string, string> = {
    tab: tab === 'stock' ? '' : tab,
    q,
    favorites: favorites ? '1' : '',
    source,
    itemClass,
    itemSubclass,
    slot: slotFilter,
    quality: qualityFilter,
    minReq: minReq ? String(minReq) : '',
    maxReq: maxReq ? String(maxReq) : '',
    history: historyFilter === 'attributed' ? '' : historyFilter,
    player: historyPlayer,
    page: itemPage > 1 ? String(itemPage) : '',
    hpage: historyPage > 1 ? String(historyPage) : '',
    lpage: ledgerPage > 1 ? String(ledgerPage) : '',
    rpage: requestPage > 1 ? String(requestPage) : ''
  };
  for (const [k, v] of Object.entries(overrides)) next[k] = v === null || v === undefined ? '' : String(v);
  if (next.tab === 'stock') next.tab = '';
  if (next.history === 'attributed') next.history = '';
  if (next.page === '1') next.page = '';
  if (next.hpage === '1') next.hpage = '';
  if (next.lpage === '1') next.lpage = '';
  if (next.rpage === '1') next.rpage = '';
  for (const [k, v] of Object.entries(next)) if (v) params.set(k, v);
  const qs = params.toString();
  return `${qs ? `/bank?${qs}` : '/bank'}${hash}`;
};
const historyUrl = (mode: string, playerOverride?: string) =>
  bankUrl({ tab: 'history', history: mode, player: playerOverride !== undefined ? playerOverride : historyPlayer, hpage: 1 });
const eligible = characters.filter(character => character.verified && character.guildRank);
const qualityClass = (name: string | null | undefined) => name ? `quality-${name.toLowerCase()}` : '';
---
<Layout title="Guild bank" account={account} guild={guild} characters={characters} isGuildMaster={isGuildMaster}>
  <div class="page-heading">
    <h1>Guild bank</h1>
    {account && (
      <div class="row-actions">
        <span class="badge">{items.length} of {bank.length} {bank.length === 1 ? 'item' : 'items'}</span>
        {openRequestCount > 0 && <a class="badge" href={bankUrl({ tab: 'requests', rpage: 1 })}>{openRequestCount} open {openRequestCount === 1 ? 'request' : 'requests'}</a>}
        {(isGuildMaster || permissions.manageGuildSync) && (bank.length > 0 || bankTransactions.length > 0) && (
          <ActionForm action="refresh-vendor-prices" label="Refresh AH & item prices" class="inline-action" />
        )}
      </div>
    )}
  </div>
  {!account ? <SignInGate /> : <>
    <div class="explorer-bar">
      <div class="explorer-tabs" role="tablist" aria-label="Guild bank view">
        <a class={`explorer-tab${tab === 'stock' ? ' explorer-tab-active' : ''}`} href={bankUrl({ tab: 'stock' })} aria-current={tab === 'stock' ? 'page' : undefined}>Bank stock ({bank.length})</a>
        <a class={`explorer-tab${tab === 'requests' ? ' explorer-tab-active' : ''}`} href={bankUrl({ tab: 'requests' })} aria-current={tab === 'requests' ? 'page' : undefined}>Requests ({openRequestCount > 0 ? `${openRequestCount} open` : requests.length})</a>
        <a class={`explorer-tab${tab === 'history' ? ' explorer-tab-active' : ''}`} href={bankUrl({ tab: 'history' })} aria-current={tab === 'history' ? 'page' : undefined}>Donation history ({visibleTransactions.filter(tx => Boolean(tx.actorName)).length})</a>
        {canViewLedger && (
          <a class={`explorer-tab${tab === 'ledger' ? ' explorer-tab-active' : ''}`} href={bankUrl({ tab: 'ledger', player: null })} aria-current={tab === 'ledger' ? 'page' : undefined}>Contribution ledger</a>
        )}
      </div>
      {tab === 'stock' && classNames.length > 0 && (
        <div class="profession-pills" aria-label="Filter by item category">
          <a class={`pill${!itemClass ? ' pill-active' : ''}`} href={bankUrl({ itemClass: null, itemSubclass: null, page: 1 })}>All</a>
          {classNames.map(cn => (
            <a class={`pill${itemClass === cn ? ' pill-active' : ''}`} href={bankUrl({ itemClass: cn, itemSubclass: null, page: 1 })}>{cn}</a>
          ))}
        </div>
      )}
    </div>

    {tab === 'stock' ? <>
      <form method="get" class="filter-bar">
        <label>Find an item<input type="search" name="q" value={q} placeholder="Item name, type, or ID…" /></label>
        {classNames.length > 0 && (
          <label>Category
            <select name="itemClass">
              <option value="">All categories</option>
              {classNames.map(cn => <option value={cn} selected={itemClass === cn}>{cn}</option>)}
            </select>
          </label>
        )}
        {subclassNames.length > 0 && (
          <label>Type
            <select name="itemSubclass">
              <option value="">All types</option>
              {subclassNames.map(sc => <option value={sc} selected={itemSubclass === sc}>{sc}</option>)}
            </select>
          </label>
        )}
        {slotNames.length > 0 && (
          <label>Slot
            <select name="slot">
              <option value="">Any slot</option>
              {slotNames.map(sl => <option value={sl} selected={slotFilter === sl}>{sl}</option>)}
            </select>
          </label>
        )}
        {qualityNames.length > 0 && (
          <label>Quality
            <select name="quality">
              <option value="">Any quality</option>
              {qualityNames.map(qn => <option value={qn} selected={qualityFilter === qn}>{qn}</option>)}
            </select>
          </label>
        )}
        <label class="level-range-field">Min level<input name="minReq" type="number" min="1" max="60" step="1" value={minReq || ''} placeholder="1" /></label>
        <label class="level-range-field">Max level<input name="maxReq" type="number" min="1" max="60" step="1" value={maxReq || ''} placeholder="60" /></label>
        <label>Bank character<select name="source"><option value="">All bank characters</option>{sourceNames.map(name => <option selected={source === name}>{name}</option>)}</select></label>
        <label class="check-label"><input type="checkbox" name="favorites" value="1" checked={favorites} /> Favorites only</label>
        <a class="text-link" href="/bank">Clear</a>
      </form>
      <div class="roster-list" data-sortable-table>
        {items.length > 0 && (
          <div class="roster-table-header roster-table-bank">
            <button type="button" class="sort-header" data-sort-col="0" data-sort-type="text">Item</button>
            <button type="button" class="sort-header" data-sort-col="1" data-sort-type="text">Type</button>
            <button type="button" class="sort-header" data-sort-col="2" data-sort-type="num">Lvl</button>
            <button type="button" class="sort-header" data-sort-col="3" data-sort-type="text">Bank</button>
            <button type="button" class="sort-header" data-sort-col="4" data-sort-type="num">Stock</button>
          </div>
        )}
        {pageItems.map(item => {
          const typeLabel = [item.itemClass, item.itemSubclass && item.itemSubclass !== item.itemClass ? item.itemSubclass : null, item.inventoryType].filter(Boolean).join(' · ');
          return (
          <details
            class="roster-row inventory-card"
            data-s-name={item.name}
            data-s0={item.name}
            data-s1={typeLabel}
            data-s2={item.requiredLevel && item.requiredLevel > 0 ? item.requiredLevel : ''}
            data-s3={item.banks.map(b => b.name).join(', ')}
            data-s4={item.count}
          >
            <summary class="roster-summary roster-summary-table roster-table-bank">
              <div class="roster-identity">
                <button
                  type="button"
                  class="fav-heart"
                  data-fav-toggle={item.itemKey}
                  aria-pressed={item.favorite ? 'true' : 'false'}
                  aria-label={item.favorite ? `Remove ${item.name} from favorites` : `Add ${item.name} to favorites`}
                  title={item.favorite ? 'Remove favorite' : 'Add favorite'}
                >
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                  </svg>
                </button>
                <strong class={`roster-name ${qualityClass(item.qualityName)}`}>{item.name}</strong>
              </div>
              <span class={`roster-cell${!typeLabel ? ' roster-cell-muted' : ''}`}>{typeLabel || '—'}</span>
              <span class={`roster-cell${!(item.requiredLevel && item.requiredLevel > 0) ? ' roster-cell-muted' : ''}`}>{item.requiredLevel && item.requiredLevel > 0 ? item.requiredLevel : '—'}</span>
              <span class="roster-cell">{item.banks.map(b => `${b.name} (${b.count})`).join(', ')}</span>
              <strong class="roster-cell stock-count-inline">{item.count}</strong>
            </summary>
            <div class="roster-details">
              <div>
                <dl class="source-details">
                  <div><dt>Item ID</dt><dd>{item.itemId}{(item.suffixId !== 0 || item.enchantId !== 0) ? ` · Suffix ${item.suffixId} · Enchant ${item.enchantId}` : ''}</dd></div>
                  {item.qualityName && <div><dt>Quality</dt><dd class={qualityClass(item.qualityName)}>{item.qualityName}</dd></div>}
                  {typeLabel && <div><dt>Type</dt><dd>{typeLabel}</dd></div>}
                  {item.itemLevel && <div><dt>Item level</dt><dd>{item.itemLevel}{item.requiredLevel ? ` (Requires Lv ${item.requiredLevel})` : ''}</dd></div>}
                  {item.ahPriceFormatted && <div><dt>AH market value</dt><dd class="donation-value">{item.ahPriceFormatted} each</dd></div>}
                  {item.vendorPriceFormatted && <div><dt>Vendor value</dt><dd class="donation-value">{item.vendorPriceFormatted} each</dd></div>}
                </dl>
                {item.banks.map(b => (
                  <dl class="source-details">
                    <div><dt>{b.name}</dt><dd>{b.count} · {b.realm}</dd></div>
                    <div><dt>Access</dt><dd>{b.viewOnly ? 'View only' : 'Requests open'}</dd></div>
                    <div><dt>Source scan</dt><dd><LocalTime value={b.observedAt} fallback="Unknown" /></dd></div>
                    <div><dt>Website received</dt><dd><LocalTime value={b.receivedAt} fallback="Unknown" /></dd></div>
                    <div><dt>Capture</dt><dd>{b.complete ? 'Complete' : 'Incomplete. Retained stock may remain.'}</dd></div>
                  </dl>
                ))}
              </div>
              <div>
                {item.banks.some(b => !b.viewOnly) && eligible.length ? (
                  <ActionForm action="request-item" label="Send request" values={{itemKey:item.itemKey,guildId:guild.id}}>
                    <label>Character<select name="characterId" required>{eligible.map(character => <option value={character.id} selected={character.isMain}>{character.name}</option>)}</select></label>
                    <label>Quantity<input name="quantity" type="number" min="1" max={item.count} step="1" value="1" required /></label>
                    <label>Reason / note (optional)<input name="note" type="text" maxlength="300" placeholder="e.g., To make guild bags" /></label>
                  </ActionForm>
                ) : <p class="notice">{eligible.length ? 'This stock is view only.' : 'Requests require a verified guild character.'}</p>}
              </div>
            </div>
          </details>
          );
        })}
      </div>
      <Pagination page={itemPage} totalPages={itemsTotalPages} totalItems={items.length} pageSize={itemPageSize} pageUrl={(p: number) => bankUrl({ page: p })} label="Bank inventory pagination" />
      {!items.length && <p class="notice">{bank.length ? 'No items match these filters.' : 'Sync your bank character from the Helping Hand addon to populate guild bank stock.'}</p>}
    </> : tab === 'requests' ? (
      <GuildPanel id="requests" title={permissions.approveBankRequests ? 'Guild requests' : 'Your requests'} icon="chest">
        <Requests requests={pageRequests} bank={bank} owner={permissions.approveBankRequests} />
        <Pagination page={requestPage} totalPages={requestTotalPages} totalItems={requests.length} pageSize={requestPageSize} pageUrl={(p: number) => bankUrl({ tab: 'requests', rpage: p })} label="Bank requests pagination" />
      </GuildPanel>
    ) : tab === 'ledger' && canViewLedger ? (
      <GuildPanel id="bank-ledger" title="Contribution ledger" icon="chest">
        <div class="stat-grid" style="margin-bottom: 18px;">
          <div class="stat-card"><strong class="donation-value">{formatCopper(ledgerTotals.donated)}</strong><span>Total donated</span></div>
          <div class="stat-card"><strong class="withdraw-value">{formatCopper(ledgerTotals.withdrawn)}</strong><span>Total withdrawn</span></div>
          <div class="stat-card"><strong class={ledgerTotals.net < 0 ? 'withdraw-value' : 'donation-value'}>{`${ledgerTotals.net < 0 ? '-' : ''}${formatCopper(Math.abs(ledgerTotals.net))}`}</strong><span>Net contributions</span></div>
        </div>
        <form method="get" action="/bank" class="filter-bar">
          <input type="hidden" name="tab" value="ledger" />
          <label>Find a character<input type="search" name="player" value={historyPlayer} placeholder="Character name…" /></label>
          <a class="text-link" href="/bank?tab=ledger">Clear</a>
        </form>
        <div class="roster-list" data-sortable-table>
          <div class="roster-table-header roster-table-5col">
            <button type="button" class="sort-header" data-sort-col="0" data-sort-type="text">Character</button>
            <button type="button" class="sort-header" data-sort-col="1" data-sort-type="num" data-sort-default="asc">Rank</button>
            <button type="button" class="sort-header" data-sort-col="2" data-sort-type="num">Donated</button>
            <button type="button" class="sort-header" data-sort-col="3" data-sort-type="num">Withdrawn</button>
            <button type="button" class="sort-header" data-sort-col="4" data-sort-type="num">Net</button>
          </div>
          {pageLedgerRows.map(member => (
            <details
              class="roster-row"
              data-s-name={member.name}
              data-s0={member.name}
              data-s1={member.guildRankIndex ?? 99}
              data-s2={member.donatedCopper ?? 0}
              data-s3={member.withdrawnCopper ?? 0}
              data-s4={member.netContributionCopper ?? 0}
            >
              <summary class="roster-summary roster-summary-table roster-table-5col">
                <div class="roster-identity">
                  <strong class="roster-name">{member.name}</strong>
                </div>
                <span class={`roster-cell ${member.guildRank ? rankQualityClass(member.guildRankIndex) : 'roster-cell-muted'}`}>{member.guildRank || 'Unknown'}</span>
                <span class={`roster-cell ${(member.donatedCopper ?? 0) > 0 ? (member.donatedQualityClass || 'donation-value') : 'roster-cell-muted'}`}>{member.donatedFormatted ?? '0c'}{member.donationCount ? ` (${member.donationCount})` : ''}</span>
                <span class={`roster-cell${(member.withdrawnCopper ?? 0) > 0 ? ' withdraw-value' : ' roster-cell-muted'}`}>{member.withdrawnFormatted ?? '0c'}{member.withdrawnCount ? ` (${member.withdrawnCount})` : ''}</span>
                <span class={`roster-cell${(member.netContributionCopper ?? 0) < 0 ? ' withdraw-value' : (member.netContributionCopper ?? 0) > 0 ? ' donation-value' : ' roster-cell-muted'}`}>{member.netContributionFormatted ?? '0c'}</span>
              </summary>
              <div class="roster-details roster-details-single">
                <div class="roster-details-actions">
                  <a class="arcane-btn arcane-btn-secondary" href={`/character/${encodeURIComponent(member.id)}`}>Open {member.name}'s profile & adjust contribution</a>
                  <a class="text-link" href={`/activity?player=${encodeURIComponent(member.name)}`}>View activity</a>
                </div>
              </div>
            </details>
          ))}
        </div>
        <Pagination page={ledgerPage} totalPages={ledgerTotalPages} totalItems={ledgerRows.length} pageSize={pageSize} pageUrl={(p: number) => bankUrl({ tab: 'ledger', lpage: p })} label="Contribution ledger pagination" />
      </GuildPanel>
    ) : (
      <GuildPanel id="bank-history" title="Donation & bank history" icon="notice">
        {visibleTransactions.length > 0 ? (
          <>
            <div class="explorer-bar">
              <div class="profession-pills" aria-label="Filter bank history">
                <a class={`pill${historyFilter === 'attributed' ? ' pill-active' : ''}`} href={historyUrl('attributed')}>Attributed only ({visibleTransactions.filter(tx => Boolean(tx.actorName)).length})</a>
                <a class={`pill${historyFilter === 'donations' ? ' pill-active' : ''}`} href={historyUrl('donations')}>Donations only ({visibleTransactions.filter(tx => Boolean(tx.isDonation)).length})</a>
                <a class={`pill${historyFilter === 'all' ? ' pill-active' : ''}`} href={historyUrl('all')}>All ({visibleTransactions.length})</a>
              </div>
              <form method="get" action="/bank" class="inline-action" data-auto-filter>
                <input type="hidden" name="tab" value="history" />
                {historyFilter !== 'attributed' && <input type="hidden" name="history" value={historyFilter} />}
                <input type="search" name="player" value={historyPlayer} list="bank-history-players" placeholder="Filter by character…" aria-label="Filter bank history by character" />
                <datalist id="bank-history-players">{historyPlayers.map(name => <option value={name} />)}</datalist>
                {historyPlayer && <a class="text-link" href={historyUrl(historyFilter, '')}>Clear</a>}
              </form>
            </div>
            {filteredHistory.length > 0 ? (
              <div class="roster-list" data-sortable-table>
                <div class="roster-table-header roster-table-5col">
                  <button type="button" class="sort-header" data-sort-col="0" data-sort-type="num">Date</button>
                  <button type="button" class="sort-header" data-sort-col="1" data-sort-type="text">Type</button>
                  <button type="button" class="sort-header" data-sort-col="2" data-sort-type="text">Player</button>
                  <button type="button" class="sort-header" data-sort-col="3" data-sort-type="text">Item / Gold</button>
                  <button type="button" class="sort-header" data-sort-col="4" data-sort-type="num">AH / Value</button>
                </div>
                {pageHistory.map(tx => (
                  <details
                    class="roster-row"
                    data-s-name={tx.itemName || tx.txType}
                    data-s0={Date.parse(tx.occurredAt || '') || 0}
                    data-s1={tx.isDonation ? 'Donation' : tx.txType}
                    data-s2={tx.actorName || ''}
                    data-s3={tx.txType === 'money-deposit' || tx.txType === 'money-withdraw' ? tx.moneyFormatted : `${tx.itemName || ''} x${tx.quantity}`}
                    data-s4={tx.totalVendorCopper}
                  >
                    <summary class="roster-summary roster-summary-table roster-table-5col">
                      <span class="roster-cell"><LocalTime value={tx.occurredAt} fallback="Unknown" /></span>
                      <span class="roster-cell">{tx.isDonation ? <span class="badge badge-donation">Donation</span> : <span class="badge">{tx.txType}</span>}</span>
                      <span class="roster-cell">{tx.actorName ? (tx.actorCharacterId ? <a class="profile-link" href={`/character/${encodeURIComponent(tx.actorCharacterId)}`}>{tx.actorName}</a> : tx.actorName) : '—'}</span>
                      <span class="roster-cell">{tx.txType === 'money-deposit' || tx.txType === 'money-withdraw' ? <span class="donation-value">{tx.moneyFormatted}</span> : `${tx.itemName || `Item #${tx.itemId}`}${tx.quantity > 1 ? ` ×${tx.quantity}` : ''}`}</span>
                      <span class={`roster-cell${tx.totalVendorCopper > 0 ? ' donation-value' : ' roster-cell-muted'}`}>{tx.totalVendorCopper > 0 ? tx.vendorFormatted : '—'}</span>
                    </summary>
                    <div class="roster-details roster-details-single">
                      <dl>
                        <div><dt>Bank character</dt><dd>{tx.bankName}</dd></div>
                        <div><dt>Action</dt><dd>{tx.isDonation ? 'Donation' : tx.txType}</dd></div>
                        {tx.itemId && <div><dt>Item ID</dt><dd>{tx.itemId}</dd></div>}
                        {tx.note && <div><dt>Note</dt><dd>{tx.note}</dd></div>}
                      </dl>
                    </div>
                  </details>
                ))}
              </div>
            ) : <p class="notice">No bank history entries match this filter.</p>}
            <Pagination page={historyPage} totalPages={historyTotalPages} totalItems={filteredHistory.length} pageSize={pageSize} pageUrl={(p: number) => bankUrl({ tab: 'history', hpage: p })} label="Bank history pagination" />
          </>
        ) : <p class="notice">No bank history imported yet.</p>}
      </GuildPanel>
    )}
  </>}
</Layout>
