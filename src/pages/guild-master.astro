---
import Layout from '../layouts/Layout.astro';
import SignInGate from '../components/SignInGate.astro';
import GuildPanel from '../components/GuildPanel.astro';
import ActionForm from '../components/ActionForm.astro';
import NewsEditor from '../components/NewsEditor.astro';
import LocalTime from '../components/LocalTime.astro';
import Pagination from '../components/Pagination.astro';
import { getPortalData } from '../server/service.mjs';
import { stripHtmlText } from '../server/sanitizeHtml.mjs';
import { rankQualityClass } from '../server/rarity.mjs';
const {account, guild, characters, isGuildMaster, ranks, news, macros, designatedBanks} = await getPortalData(Astro.request);
const bankNamesText = designatedBanks.map(b => b.name).join('\n');
const newsPageSize = 10;
const newsTotalPages = Math.max(1, Math.ceil(news.length / newsPageSize));
const rawNPage = Number(Astro.url.searchParams.get('npage') || '1');
const newsPage = Number.isSafeInteger(rawNPage) && rawNPage >= 1 ? Math.min(rawNPage, newsTotalPages) : 1;
const pageNews = news.slice((newsPage - 1) * newsPageSize, newsPage * newsPageSize);
const newsPageUrl = (p: number) => `${p > 1 ? `/guild-master?npage=${p}` : '/guild-master'}#guild-news`;
---
<Layout title="Guild Master" account={account} guild={guild} characters={characters} isGuildMaster={isGuildMaster}>
<div class="page-heading"><h1>Guild Master</h1>{guild && <span class="badge">{guild.name}</span>}</div>
{!account ? <SignInGate /> : !isGuildMaster ? (
  <GuildPanel id="gm-restricted" title="Access restricted" icon="notice">
    <p class="notice">Select a Guild Master character in the navigation bar to manage rank permissions and guild settings.</p>
    <a class="text-link" href="/account">View your characters</a>
  </GuildPanel>
) : <>
  <GuildPanel id="guild-branding" title="Guild display name" icon="notice">
    <ActionForm action="save-guild-branding" label="Save name" class="stacked-form">
      <label>Guild display name<input name="displayName" maxlength="100" value={guild?.displayName || ''} placeholder={guild?.rawName || 'Guild name'} /></label>
    </ActionForm>
    {guild?.id && (
      <p class="data-age" style="margin-top: 14px;">
        Public feedback link for outsiders:{' '}
        <a class="text-link" href={`/${encodeURIComponent(guild.id.startsWith('bnet:') ? guild.id.split(':').slice(2).join(':') : guild.id)}/feedback`}>
          /{guild.id.startsWith('bnet:') ? guild.id.split(':').slice(2).join(':') : guild.id}/feedback
        </a>
      </p>
    )}
  </GuildPanel>

  <GuildPanel id="rank-permissions" title="Rank permissions" icon="users">
    <div class="rank-grid">
      {ranks.map(rank => (
        <article class={`rank-card${rank.rankIndex === 0 ? ' rank-card-gm' : ''}`}>
          <div class="card-heading">
            <h3 class={rankQualityClass(rank.rankIndex)}>{rank.name}</h3>
            <span class="badge">Rank {rank.rankIndex}</span>
          </div>
          {rank.rankIndex === 0 ? (
            <p class="notice">Guild Master always holds every permission.</p>
          ) : (
            <ActionForm action="save-rank-permissions" label="Save rank" values={{rankIndex:rank.rankIndex}} class="rank-form">
              <label>Rank name<input name="name" maxlength="60" required value={rank.name} /></label>
              <label class="check-label"><input type="checkbox" name="approveBankRequests" checked={rank.permissions.approveBankRequests} /> Approve, decline, and fulfill bank requests</label>
              <label class="check-label"><input type="checkbox" name="assignTitles" checked={rank.permissions.assignTitles} /> Assign guild profession titles</label>
              <label class="check-label"><input type="checkbox" name="manageGuildSync" checked={rank.permissions.manageGuildSync} /> Sync guild data and manage bank characters</label>
              <label class="check-label"><input type="checkbox" name="manageAnnouncements" checked={rank.permissions.manageAnnouncements} /> Publish and manage guild news</label>
            </ActionForm>
          )}
        </article>
      ))}
    </div>
  </GuildPanel>

  <GuildPanel id="guild-macros" title="Guild macros" icon="notice">
    <ActionForm action="add-macro" label="Add macro" class="stacked-form">
      <label>Macro title<input name="title" maxlength="80" required placeholder="e.g., Helping hand shoutout" /></label>
      <label>Macro text (WoW in-game macro limit is 255 characters)<textarea name="body" rows="3" maxlength="500" required placeholder="/say Band of the Helping Hand is dedicated to helping guildies and strangers alike! Let them know I helped you at bit.ly/helpinghand"></textarea></label>
    </ActionForm>
    {macros.length > 0 && (
      <div class="macro-list" style="margin-top: 16px;">
        {macros.map(macro => (
          <article class="macro-item">
            <div class="macro-item-header">
              <strong>{macro.title}</strong>
              <div class="row-actions">
                <button type="button" class="btn-subtle" data-copy-text={macro.body}>Copy</button>
                <ActionForm action="delete-macro" label="Delete" values={{ id: macro.id }} class="inline-action" buttonClass="btn-subtle btn-subtle-danger" />
              </div>
            </div>
            <pre class="macro-code">{macro.body}</pre>
          </article>
        ))}
      </div>
    )}
  </GuildPanel>

  <GuildPanel id="guild-news" title="Guild news" icon="notice">
    <NewsEditor />
    {pageNews.length > 0 && (
      <div class="roster-list news-list" data-sortable-table>
        <div class="roster-table-header roster-table-news-admin">
          <button type="button" class="sort-header" data-sort-col="0" data-sort-type="text">Title</button>
          <button type="button" class="sort-header" data-sort-col="1" data-sort-type="text">Author</button>
          <button type="button" class="sort-header" data-sort-col="2" data-sort-type="num">Published</button>
          <span>Actions</span>
        </div>
        {pageNews.map(item => {
          const postUrl = `/news/${encodeURIComponent(item.id)}`;
          const pubMs = item.publishedAt ? (Date.parse(item.publishedAt) || 0) : 0;
          return (
            <div class="roster-row news-entry" data-s0={item.title || ''} data-s1={item.authorName || ''} data-s2={String(pubMs)}>
              <div class="roster-summary roster-summary-table roster-summary-static roster-table-news-admin">
                <div class="news-entry-main">
                  <a class="news-link" href={postUrl}><strong>{item.title}</strong></a>
                  <a class="news-excerpt-link" href={postUrl}>
                    <p class="news-excerpt">{stripHtmlText(item.html)}</p>
                  </a>
                </div>
                <span class="roster-cell">{item.authorName}</span>
                <span class="roster-cell roster-cell-muted"><LocalTime value={item.publishedAt} fallback="Never" /></span>
                <div class="row-actions">
                  <a class="btn-subtle" href={`${postUrl}?edit=1`}>Edit</a>
                  <ActionForm action="delete-news" label="Delete" values={{id:item.id}} class="inline-action" buttonClass="btn-subtle btn-subtle-danger" />
                </div>
              </div>
            </div>
          );
        })}
      </div>
    )}
    {!news.length && <p class="notice">No guild news published yet.</p>}
    <Pagination page={newsPage} totalPages={newsTotalPages} totalItems={news.length} pageSize={newsPageSize} pageUrl={newsPageUrl} label="Guild news pagination" />
  </GuildPanel>

  <GuildPanel id="designated-banks" title="Designated bank characters" icon="chest">
    <ActionForm action="save-designated-banks" label="Save bank characters" class="stacked-form">
      <label>Bank character names (one per line)<textarea name="bankNames" rows="4" placeholder="Linda Helpinghand">{bankNamesText}</textarea></label>
    </ActionForm>
    <p class="notice">Only bank characters listed here can upload guild bank stock to the website.</p>
  </GuildPanel>
</>}
</Layout>
