---
import Layout from '../layouts/Layout.astro';
import SignInGate from '../components/SignInGate.astro';
import ActionForm from '../components/ActionForm.astro';
import Pagination from '../components/Pagination.astro';
import { getPortalData } from '../server/service.mjs';
import { professionColumnList, professionCap } from '../server/professionSlots.mjs';
import { professionQualityClass } from '../server/rarity.mjs';
const {account, guild, professions, characters, isGuildMaster, permissions} = await getPortalData(Astro.request);
const q = Astro.url.searchParams.get('q')?.trim() || '';
const ql = q.toLowerCase();
const selectedProfession = Astro.url.searchParams.get('profession')?.trim() || '';
const minSkillParam = Astro.url.searchParams.get('minSkill')?.trim() || '';
const minSkill = minSkillParam && /^\d+$/.test(minSkillParam) ? Number(minSkillParam) : 0;
const view = Astro.url.searchParams.get('view') === 'crafters' ? 'crafters' : 'recipes';
const titledOnly = Astro.url.searchParams.get('titled') === '1';

const professionNames = [...new Set(professions.map(p => p.name))].sort((a, b) => a.localeCompare(b));
const profColumns = professionColumnList(professionNames);
const isProfVisibleDefault = (name: string) => Boolean(selectedProfession) && selectedProfession === name;
const defaultVisibleProfCount = profColumns.filter(isProfVisibleDefault).length;
const filteredProfessions = professions.filter(p =>
  (!selectedProfession || p.name === selectedProfession) &&
  (!minSkill || (p.rank ?? 0) >= minSkill) &&
  (!titledOnly || p.titles.length > 0)
);

const records = filteredProfessions
  .map(profession => ({
    ...profession,
    matches: profession.recipes.filter(recipe =>
      `${recipe.name} ${profession.name} ${profession.characterName} ${profession.titles.join(' ')}`.toLowerCase().includes(ql)
    )
  }))
  .filter(profession => !q || profession.matches.length > 0)
  .sort((a, b) => Number(b.titles.length > 0) - Number(a.titles.length > 0) || (b.rank ?? 0) - (a.rank ?? 0) || a.characterName.localeCompare(b.characterName));

const recipeMap = new Map<string, {
  id: number;
  name: string;
  professionName: string;
  crafters: Array<{
    characterId: string;
    characterName: string;
    rank: number | null;
    maxRank: number | null;
    titles: string[];
  }>;
}>();

for (const prof of records) {
  for (const recipe of prof.matches) {
    const key = `${prof.name}:${recipe.id}`;
    const entry = recipeMap.get(key) ?? { id: recipe.id, name: recipe.name, professionName: prof.name, crafters: [] };
    entry.crafters.push({
      characterId: prof.characterId,
      characterName: prof.characterName,
      rank: prof.rank,
      maxRank: prof.maxRank,
      titles: prof.titles,
    });
    recipeMap.set(key, entry);
  }
}

const groupedRecipes = [...recipeMap.values()]
  .map(item => ({
    ...item,
    crafters: item.crafters.sort((a, b) =>
      Number(b.titles.length > 0) - Number(a.titles.length > 0) ||
      (b.rank ?? 0) - (a.rank ?? 0) ||
      a.characterName.localeCompare(b.characterName)
    )
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const crafterMap = new Map<string, {
  characterId: string;
  characterName: string;
  titles: string[];
  professions: typeof records;
  topRank: number;
  totalRecipes: number;
}>();

for (const prof of records) {
  const existing = crafterMap.get(prof.characterId) ?? {
    characterId: prof.characterId,
    characterName: prof.characterName,
    titles: prof.titles,
    professions: [],
    topRank: 0,
    totalRecipes: 0,
  };
  existing.professions.push(prof);
  existing.topRank = Math.max(existing.topRank, prof.rank ?? 0);
  existing.totalRecipes += prof.matches.length;
  crafterMap.set(prof.characterId, existing);
}

const groupedCrafters = [...crafterMap.values()]
  .map(crafter => ({
    ...crafter,
    professions: crafter.professions.sort((a, b) => (b.rank ?? 0) - (a.rank ?? 0) || a.name.localeCompare(b.name)),
  }))
  .sort((a, b) =>
    Number(b.titles.length > 0) - Number(a.titles.length > 0) ||
    b.topRank - a.topRank ||
    a.characterName.localeCompare(b.characterName)
  );

const pageSize = 50;
const activeTotal = view === 'recipes' ? groupedRecipes.length : groupedCrafters.length;
const totalPages = Math.max(1, Math.ceil(activeTotal / pageSize));
const rawPage = Number(Astro.url.searchParams.get('page') || '1');
const page = Number.isSafeInteger(rawPage) && rawPage >= 1 ? Math.min(rawPage, totalPages) : 1;
const pageRecipes = groupedRecipes.slice((page - 1) * pageSize, page * pageSize);
const pageCrafters = groupedCrafters.slice((page - 1) * pageSize, page * pageSize);

const buildUrl = (overrides: Record<string, string | null>) => {
  const params = new URLSearchParams();
  const next = { q, profession: selectedProfession, minSkill: minSkill ? String(minSkill) : '', view, titled: titledOnly ? '1' : '', page: page > 1 ? String(page) : '', ...overrides };
  if (overrides.view !== undefined || overrides.profession !== undefined) next.page = '';
  if (next.page === '1') next.page = '';
  for (const [k, v] of Object.entries(next)) {
    if (v && !(k === 'view' && v === 'recipes')) params.set(k, v);
  }
  const qs = params.toString();
  return qs ? `/professions?${qs}` : '/professions';
};
---
<Layout title="Guild professions" account={account} guild={guild} characters={characters} isGuildMaster={isGuildMaster}>
<div class="page-heading">
  <h1>Guild professions</h1>
  {account && guild?.id?.startsWith('bnet:') && (isGuildMaster || permissions.manageGuildSync) && (
    <ActionForm action="refresh-guild-professions" label="Refresh guild recipes from Battle.net" />
  )}
</div>
{!account ? <SignInGate /> : <>
  <form method="get" class="filter-bar">
    <input type="hidden" name="view" value={view} />
    <label>Find a recipe, profession, or crafter<input type="search" name="q" value={q} placeholder="Potion, Elixir, Bag, Enchant…" /></label>
    <label>Profession
      <select name="profession">
        <option value="">All professions ({professionNames.length})</option>
        {professionNames.map(name => <option value={name} selected={selectedProfession === name}>{name}</option>)}
      </select>
    </label>
    <label>Skill level
      <select name="minSkill">
        <option value="">Any skill</option>
        <option value="75" selected={minSkill === 75}>75+ (Journeyman)</option>
        <option value="150" selected={minSkill === 150}>150+ (Expert)</option>
        <option value="225" selected={minSkill === 225}>225+ (Artisan)</option>
        <option value="300" selected={minSkill === 300}>300 (Master)</option>
      </select>
    </label>
    <label class="check-label"><input type="checkbox" name="titled" value="1" checked={titledOnly} /> Designated crafters only</label>
    <a class="text-link" href="/professions">Clear</a>
  </form>

  <div class="explorer-bar">
    <div class="explorer-tabs" role="tablist" aria-label="Explorer view">
      <a class={`explorer-tab${view === 'recipes' ? ' explorer-tab-active' : ''}`} href={buildUrl({ view: 'recipes' })} aria-current={view === 'recipes' ? 'page' : undefined}>By recipe ({groupedRecipes.length})</a>
      <a class={`explorer-tab${view === 'crafters' ? ' explorer-tab-active' : ''}`} href={buildUrl({ view: 'crafters' })} aria-current={view === 'crafters' ? 'page' : undefined}>By crafter ({groupedCrafters.length})</a>
    </div>
    <div class="profession-pills" aria-label="Filter by profession">
      <a class={`pill${!selectedProfession ? ' pill-active' : ''}`} href={buildUrl({ profession: null })}>All</a>
      {professionNames.map(name => (
        <a class={`pill${selectedProfession === name ? ' pill-active' : ''}`} href={buildUrl({ profession: name })}>{name}</a>
      ))}
    </div>
  </div>

  {view === 'recipes' ? (
    <>
      <div class="roster-list" data-sortable-table>
        {groupedRecipes.length > 0 && (
          <div class="roster-table-header roster-table-3col">
            <button type="button" class="sort-header" data-sort-col="0" data-sort-type="text">Recipe</button>
            <button type="button" class="sort-header" data-sort-col="1" data-sort-type="text">Profession</button>
            <button type="button" class="sort-header" data-sort-col="2" data-sort-type="num">Crafters</button>
          </div>
        )}
        {pageRecipes.map(recipe => (
          <details
            class="roster-row"
            open={Boolean(q && groupedRecipes.length <= 10)}
            data-s-name={recipe.name}
            data-s0={recipe.name}
            data-s1={recipe.professionName}
            data-s2={recipe.crafters.length}
          >
            <summary class="roster-summary roster-summary-table roster-table-3col">
              <div class="roster-identity">
                <strong class="roster-name">{recipe.name}</strong>
              </div>
              <span class="roster-cell">{recipe.professionName}</span>
              <span class="roster-cell">{recipe.crafters.length} {recipe.crafters.length === 1 ? 'crafter' : 'crafters'}</span>
            </summary>
            <div class="roster-details roster-details-single">
              <div class="crafter-list">
                {recipe.crafters.map(crafter => (
                  <div class="crafter-row">
                    <div>
                      <a class="profile-link" href={`/character/${encodeURIComponent(crafter.characterId)}`}><strong>{crafter.characterName}</strong></a>
                      <span class={`crafter-meta ${crafter.rank !== null ? professionQualityClass(crafter.rank, professionCap(recipe.professionName, crafter.maxRank, crafter.rank)) : ''}`}>{crafter.rank !== null ? `${crafter.rank} / ${professionCap(recipe.professionName, crafter.maxRank, crafter.rank)}` : ''}</span>
                    </div>
                    <div class="badges">
                      {crafter.titles.map(title => <span class="badge">{title}</span>)}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </details>
        ))}
      </div>
      <Pagination page={page} totalPages={totalPages} totalItems={groupedRecipes.length} pageSize={pageSize} pageUrl={(p: number) => buildUrl({ page: String(p) })} label="Recipes pagination" />
      {!groupedRecipes.length && <p class="notice">{professions.length ? 'No recipes match your filters.' : 'Refresh guild recipes from Battle.net or sync from the addon to fill this directory.'}</p>}
    </>
  ) : (
    <>
      <details class="column-picker" data-column-picker="crafters-prof-cols" data-target="crafters-table" data-force-col={selectedProfession || ''}>
        <summary class="column-picker-summary">
          <span class="column-picker-label">Profession columns</span>
          <span class="badge" data-col-count>{defaultVisibleProfCount} shown</span>
        </summary>
        <div class="column-picker-body">
          <div class="column-picker-list">
            {profColumns.map(name => (
              <label class="column-picker-item">
                <input type="checkbox" value={name} checked={isProfVisibleDefault(name)} />
                <span>{name}</span>
              </label>
            ))}
          </div>
          <div class="column-picker-actions">
            <button type="button" class="text-link" data-col-all>All</button>
            <button type="button" class="text-link" data-col-none>None</button>
          </div>
        </div>
      </details>
      <div class="roster-table-scroll">
      <div id="crafters-table" class="roster-list" data-sortable-table data-has-prof-cols={defaultVisibleProfCount > 0 ? '1' : '0'} style={defaultVisibleProfCount > 0 ? `--prof-cols: ${defaultVisibleProfCount}` : undefined}>
        {groupedCrafters.length > 0 && (
          <div class="roster-table-header roster-table-crafters">
            <button type="button" class="sort-header" data-sort-col="0" data-sort-type="text">Crafter</button>
            {profColumns.map((profName, idx) => (
              <button type="button" class="sort-header" data-sort-col={String(1 + idx)} data-sort-type="num" data-prof-col={profName} hidden={!isProfVisibleDefault(profName)}>{profName}</button>
            ))}
          </div>
        )}
        {pageCrafters.map(crafter => {
          const byProf = new Map(crafter.professions.map(p => [p.name, p]));
          const profSortAttrs = Object.fromEntries(profColumns.map((profName, idx) => {
            const entry = byProf.get(profName);
            return [`data-s${1 + idx}`, entry && entry.rank !== null ? String(entry.rank) : ''];
          }));
          return (
          <details
            class="roster-row"
            open={Boolean(q && groupedCrafters.length <= 10)}
            data-s-name={crafter.characterName}
            data-s0={crafter.characterName}
            {...profSortAttrs}
          >
            <summary class="roster-summary roster-summary-table roster-table-crafters">
              <div class="roster-identity">
                <strong class="roster-name">{crafter.characterName}</strong>
                <span class="roster-meta">{crafter.totalRecipes} {crafter.totalRecipes === 1 ? 'recipe' : 'recipes'}</span>
                {crafter.titles.map(title => <span class="badge">{title}</span>)}
              </div>
              {profColumns.map(profName => {
                const entry = byProf.get(profName);
                const learned = Boolean(entry);
                const cap = learned ? professionCap(profName, entry!.maxRank, entry!.rank) : 300;
                const qClass = learned && entry!.rank !== null ? professionQualityClass(entry!.rank, cap) : 'roster-cell-muted';
                const label = learned ? (entry!.rank !== null ? String(entry!.rank) : 'Learned') : '—';
                return (
                  <span class={`roster-cell ${qClass}${selectedProfession === profName && learned ? ' roster-cell-active' : ''}`} data-prof-col={profName} data-col={profName} hidden={!isProfVisibleDefault(profName)}>
                    {label}
                  </span>
                );
              })}
            </summary>
            <div class="roster-details roster-details-single">
              <div class="roster-details-actions">
                <a class="arcane-btn arcane-btn-secondary" href={`/character/${encodeURIComponent(crafter.characterId)}`}>View {crafter.characterName}'s profile</a>
              </div>
              {crafter.professions.map(profession => { const cap = professionCap(profession.name, profession.maxRank, profession.rank); const qClass = professionQualityClass(profession.rank, cap); return (
                <div class="roster-prof-item">
                  <div class="card-heading">
                    <strong class={qClass}>{profession.name}</strong>
                    <span class={`skill-rank ${qClass}`}>{profession.rank} / {cap} · {profession.matches.length} {profession.matches.length === 1 ? 'recipe' : 'recipes'}</span>
                  </div>
                  <progress class={qClass} value={profession.rank} max={cap} aria-label={`${crafter.characterName} ${profession.name} skill`}></progress>
                  {profession.matches.length > 0 && (
                    <div class="recipe-chip-list">
                      {profession.matches.map(recipe => <span class="prof-chip">{recipe.name}</span>)}
                    </div>
                  )}
                </div>
              ); })}
            </div>
          </details>
          );
        })}
      </div>
      </div>
      <Pagination page={page} totalPages={totalPages} totalItems={groupedCrafters.length} pageSize={pageSize} pageUrl={(p: number) => buildUrl({ page: String(p) })} label="Crafters pagination" />
      {!groupedCrafters.length && <p class="notice">{professions.length ? 'No crafters match your filters.' : 'Refresh guild recipes from Battle.net or sync from the addon to fill this directory.'}</p>}
    </>
  )}
</>}
</Layout>
