---
import Layout from '../layouts/Layout.astro';
import SignInGate from '../components/SignInGate.astro';
import ActionForm from '../components/ActionForm.astro';
import { getPortalData } from '../server/service.mjs';
const {account, professions, roster} = await getPortalData(Astro.request);
const q = Astro.url.searchParams.get('q') || '';
const offeredOnly = Astro.url.searchParams.get('offered') === '1';
const records = professions.map(profession => ({...profession, matches:profession.recipes.filter(recipe => `${recipe.name} ${profession.name} ${profession.characterName}`.toLowerCase().includes(q.toLowerCase()) && (!offeredOnly || recipe.offered))})).filter(profession => !q && !offeredOnly || profession.matches.length);
---
<Layout title="Guild professions" account={account}><div class="page-heading"><h1>Guild professions</h1></div>
{!account ? <SignInGate /> : <>
<form method="get" class="filter-bar"><label>Find a craft or character<input type="search" name="q" value={q} /></label><label class="check-label"><input type="checkbox" name="offered" value="1" checked={offeredOnly} /> Offered crafts only</label><button class="arcane-btn" type="submit">Search</button><a class="text-link" href="/professions">Clear</a></form>
<div class="profession-grid">{records.map(profession => <article class="profession-card"><div class="card-heading"><h2>{profession.name}</h2><span class="skill-rank">{profession.rank} / {profession.maxRank}</span></div><div class="profession-character">{profession.characterName}<div class="badges">{profession.titles.map(title => <span class="badge">{title}</span>)}</div></div><progress value={profession.rank} max={profession.maxRank || 1} aria-label={`${profession.characterName} ${profession.name} skill`}></progress><p class="data-age">Last sync: {profession.updatedAt ? new Date(profession.updatedAt).toLocaleString('en-US',{timeZone:'UTC'}) + ' UTC' : 'Unknown'}</p><div class="recipe-list">{profession.matches.map(recipe => <div class="recipe-row"><div><h3>{recipe.name}</h3><span class="badge">{recipe.offered ? 'Offered to guild' : 'Known recipe'}</span></div>{recipe.canEdit && <ActionForm action="set-offer" label={recipe.offered ? 'Stop offering' : 'Offer to guild'} values={{recipeKey:recipe.recipeKey,offered:!recipe.offered}} />}</div>)}</div>{!profession.recipes.length && <p class="notice">Open this profession in the game, then capture and sync learned recipes.</p>}</article>)}</div>
{!records.length && <p class="notice">{professions.length ? 'No crafts match your search.' : 'Sync character professions from the addon to fill this directory.'}</p>}
{account.role === 'owner' && <section class="guild-panel arcane-card-highlight" aria-labelledby="titles-heading"><h2 id="titles-heading">Guild profession titles</h2><div class="title-manager">{roster.map(character => <article><h3>{character.name}</h3><div class="badges">{character.titles.map(title => <ActionForm action="set-title" label={`Remove ${title}`} values={{characterId:character.id,title,assigned:false}} />)}</div><ActionForm action="set-title" label="Assign title" values={{characterId:character.id,assigned:true}}><label>Title<input name="title" maxlength="80" required placeholder="Guild Alchemist" /></label></ActionForm></article>)}</div>{!roster.length && <p class="notice">Sync the roster before assigning guild profession titles.</p>}</section>}
</>}
</Layout>
