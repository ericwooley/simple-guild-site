---
import Layout from '../../layouts/Layout.astro';
import SignInGate from '../../components/SignInGate.astro';
import GuildPanel from '../../components/GuildPanel.astro';
import ActionForm from '../../components/ActionForm.astro';
import NewsEditor from '../../components/NewsEditor.astro';
import LocalTime from '../../components/LocalTime.astro';
import { getGuildNewsItem, getPortalData } from '../../server/service.mjs';

const newsId = Astro.params.id ? decodeURIComponent(Astro.params.id) : '';
const editOpen = Astro.url.searchParams.get('edit') === '1';
const { account, guild, characters, isGuildMaster, permissions, news } = await getPortalData(Astro.request);
const item = (news.find(n => n.id === newsId) ?? (guild ? await getGuildNewsItem(guild.id, newsId) : null));
---
<Layout title={item ? item.title : 'Guild news'} account={account} guild={guild} characters={characters} isGuildMaster={isGuildMaster}>
  <div class="page-heading">
    <h1>{item ? item.title : 'Guild news'}</h1>
    <a class="text-link" href="/">Back to Guild Hall</a>
  </div>
  {!account ? <SignInGate /> : !item ? (
    <GuildPanel id="news-missing" title="Post not found" icon="notice">
      <p class="notice">This guild news post could not be found or may have been deleted.</p>
      <a class="text-link" href="/">Return to Guild Hall</a>
    </GuildPanel>
  ) : (
    <GuildPanel id="news-article" title="Guild news" icon="notice">
      <article class="news-article">
        <div class="news-article-meta">
          <p class="data-age">Published <LocalTime value={item.publishedAt} fallback="Never" /> by {item.authorName}</p>
          {permissions.manageAnnouncements && (
            <div class="news-article-actions">
              <ActionForm action="delete-news" label="Delete" values={{ id: item.id, redirect: '/' }} class="inline-action" buttonClass="btn-subtle btn-subtle-danger" />
            </div>
          )}
        </div>
        {permissions.manageAnnouncements && (
          <details class="news-composer" open={editOpen}>
            <summary class="btn-subtle">Edit post</summary>
            <div class="news-composer-body">
              <NewsEditor action="edit-news" label="Save changes" id={item.id} initialTitle={item.title} initialHtml={item.html} />
            </div>
          </details>
        )}
        <div class="news-rich-body news-article-body" set:html={item.html}></div>
      </article>
    </GuildPanel>
  )}
</Layout>
