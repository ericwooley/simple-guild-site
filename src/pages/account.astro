---
import Layout from '../layouts/Layout.astro';
import SignInGate from '../components/SignInGate.astro';
import GuildPanel from '../components/GuildPanel.astro';
import ActionForm from '../components/ActionForm.astro';
import { getPortalData } from '../server/service.mjs';
const {account, guild, characters, tokens, syncs} = await getPortalData(Astro.request);
const date = value => value ? new Date(value).toLocaleString('en-US',{timeZone:'UTC'}) + ' UTC' : 'Never';
---
<Layout title="My account" account={account}><div class="page-heading"><h1>My account</h1>{account && <ActionForm action="logout" label="Sign out" />}</div>
{!account ? <SignInGate /> : <>
<div class="account-strip"><strong>{account.battleTag}</strong><span>{guild?.name || 'Guild membership needs verification'}</span>{account.testAccount && <span class="badge">Local test account</span>}<span class="badge">{account.role === 'owner' ? 'Guild owner' : account.role === 'member' ? 'Guild member' : 'Not verified'}</span></div>
<GuildPanel id="characters" title="Your characters" icon="users"><div class="character-grid">{characters.map(character => <article class="character-card"><h3>{character.name}</h3><dl><div><dt>Character</dt><dd>Level {character.level} {character.className}</dd></div><div><dt>Realm</dt><dd>{character.realm}</dd></div><div><dt>Guild rank</dt><dd>{character.guildRank || 'Unknown'}</dd></div><div><dt>Ownership</dt><dd>{character.verified ? 'Verified' : 'Needs verification'}</dd></div></dl><div class="badges">{character.titles.map(title => <span class="badge">{title}</span>)}</div>{character.isMain ? <span class="badge">Main character</span> : character.verified && <ActionForm action="set-main" label="Make main character" values={{characterId:character.id}} />}</article>)}</div>{!characters.length && <p class="notice">Character verification must complete before you can sync records or request bank items.</p>}</GuildPanel>
<GuildPanel id="addon-sync" title="Addon Sync" icon="notice">
{account.role ? <><div class="sync-instructions"><ol><li>Generate a sync token.</li><li>Paste the token into the Helping Hand addon settings.</li><li>Capture your data in the addon.</li><li>Reload the game interface, then run the local bridge.</li></ol><a class="arcane-btn arcane-btn-secondary" href="/downloads/HelpingHand.zip" download>Download addon</a></div><ActionForm action="issue-token" label="Generate sync token"><label>Sync permission<select name="scope"><option value="member">My verified characters and professions</option>{account.role === 'owner' && <option value="guild">Guild roster, bank, and available professions</option>}</select></label></ActionForm>
<section id="token-reveal" class="token-reveal" hidden aria-labelledby="new-token-heading"><h3 id="new-token-heading">Your new sync token</h3><p>Copy this token now. Keep it private. This page shows it once.</p><label>Sync token<textarea id="new-token" readonly rows="4" autocomplete="off" spellcheck="false"></textarea></label><button id="copy-token" class="arcane-btn" type="button">Copy token</button><p id="copy-status" role="status"></p><a class="text-link" href="/account">Done</a></section>
<div class="record-list">{tokens.map(token => <article class="record-row"><div><h3>{token.scope === 'guild' ? 'Guild sync' : 'Member sync'}</h3><dl><div><dt>Status</dt><dd>{token.revokedAt ? 'Revoked' : new Date(token.expiresAt).getTime() <= Date.now() ? 'Expired' : 'Active'}</dd></div><div><dt>Expires</dt><dd>{date(token.expiresAt)}</dd></div><div><dt>Last use</dt><dd>{date(token.lastUsedAt)}</dd></div></dl></div>{!token.revokedAt && <ActionForm action="revoke-token" label="Revoke token" values={{id:token.id}} />}</article>)}</div></> : <p class="notice">Verify your character ownership and guild membership before generating a sync token.</p>}
</GuildPanel>
<GuildPanel id="sync-history" title="Sync history" icon="notice"><div class="record-list">{syncs.map(sync => <article class="record-row"><div><h3>{sync.summary}</h3><p><span class="badge">{sync.status}</span></p><dl><div><dt>Source capture</dt><dd>{date(sync.capturedAt)}</dd></div><div><dt>Website received</dt><dd>{date(sync.receivedAt)}</dd></div></dl></div></article>)}</div>{!syncs.length && <p class="notice">No uploads yet. Capture a snapshot in the addon, then send it with the bridge.</p>}</GuildPanel>
</>}
</Layout>
