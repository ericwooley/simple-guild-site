{
  "name": "band-of-the-helping-hand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build",
    "test": "node --test tests/*.test.mjs",
    "test:addon": "python3 scripts/test-addon-readers.py",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "db:dev": "docker compose up --abort-on-container-exit postgres",
    "db:shell": "docker compose exec postgres psql -U guild -d guild"
  },
  "dependencies": { "astro": "7.4.13" }
}
