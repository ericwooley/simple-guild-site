{
  "name": "band-of-the-helping-hand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev --host 127.0.0.1 --port 4321",
    "build": "python3 scripts/package-addon.py && astro build",
    "test": "node --test tests/*.test.mjs",
    "test:addon": "python3 scripts/test-addon-readers.py",
    "preview": "node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs preview --host 127.0.0.1 --port 4321",
    "db:dev": "docker compose up --abort-on-container-exit postgres",
    "db:shell": "docker compose exec postgres psql -U guild -d guild",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env scripts/db-seed.mjs",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:bridge": "python3 -m unittest discover -s tests -p test_bridge.py",
    "test:addon:app": "python3 scripts/test-helping-hand-addon.py",
    "addon:package": "python3 scripts/package-addon.py",
    "setup:local": "node scripts/setup-local.mjs",
    "test:db": "RUN_DB_TESTS=1 node --env-file-if-exists=.env --test tests/server-integration.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.14",
    "astro": "7.4.13",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
